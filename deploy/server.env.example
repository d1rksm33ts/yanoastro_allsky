TZ=Europe/Brussels

INDIALLSKY_IMAGE_FOLDER=/var/www/html/allsky/images
INDIALLSKY_FLASK_AUTH_ALL_VIEWS=false
INDIALLSKY_FLASK_SECRET_KEY=replace-with-long-random-hex
INDIALLSKY_FLASK_PASSWORD_KEY=replace-with-fernet-key

INDIALLSKY_WEB_USER=replace-with-admin-user
INDIALLSKY_WEB_PASS=replace-with-admin-password
INDIALLSKY_WEB_NAME=replace-with-admin-name
INDIALLSKY_WEB_EMAIL=replace-with-admin-email
INDIALLSKY_WEB_GENERATE_APIKEY=false

INDIALLSKY_MARIADB_HOST=mariadb.indi.allsky
INDIALLSKY_MARIADB_PORT=3306
INDIALLSKY_MARIADB_SSL=false
INDIALLSKY_MARIADB_CHARSET=utf8mb4
INDIALLSKY_MARIADB_COLLATION=utf8mb4_unicode_ci

MARIADB_ROOT_PASSWORD=replace-with-random-root-password
MARIADB_DATABASE=indi_allsky
MARIADB_USER=indi_allsky_own
MARIADB_PASSWORD=replace-with-database-password
MARIADB_BACKUP_RETENTION_DAYS=14

# The application is reachable only through the internal nginx container.
FORWARDED_ALLOW_IPS=*
