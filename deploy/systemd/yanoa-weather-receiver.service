[Unit]
Description=YaNoAstro local weather-station receiver
After=network.target

[Service]
Type=simple
User=smeets
Group=smeets
ExecStart=/usr/local/lib/yanoa-allsky/weather_receiver.py
Restart=on-failure
RestartSec=5
StateDirectory=yanoa-weather
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
